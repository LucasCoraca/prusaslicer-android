+// No fontconfig on Android: system fonts live in /system/fonts as <Family>-<Style>.ttf (Roboto, NotoSerif, ...).
+// Map the face name there, falling back to Roboto.
+static std::string android_font_path(const wxFont &font)
+{
+    std::string family = font.GetFaceName().ToUTF8().data();
+    family.erase(std::remove(family.begin(), family.end(), ' '), family.end());
+    const bool bold   = font.GetWeight() >= wxFONTWEIGHT_BOLD;
+    const bool italic = font.GetStyle() != wxFONTSTYLE_NORMAL;
+    const std::string style = bold ? (italic ? "BoldItalic" : "Bold") : (italic ? "Italic" : "Regular");
+    for (const std::string &name : { family, std::string("Roboto") })
+        for (const std::string &suffix : { "-" + style, std::string("-Regular"), std::string() })
+            for (const char *ext : { ".ttf", ".otf" }) {
+                const std::string path = "/system/fonts/" + name + suffix + ext;
+                if (!name.empty() && boost::filesystem::exists(path))
+                    return path;
+            }
+    return {};
+}
+#endif // __ANDROID__
