+// A phone in landscape has room for the search field in the button row.
+void TopBarItemsCtrl::update_phone_layout()
+{
+    const bool in_row = GetSize().GetWidth() >= 50 * em_unit(this);
+    if (in_row == m_phone_search_in_row)
+        return;
+    m_phone_search_in_row = in_row;
+
+    if (in_row) {
+        m_sizer->Detach(m_search);
+        int spacer_idx = 0;
+        for (const wxSizerItem* item : m_phone_row_sizer->GetChildren()) {
+            if (item == m_phone_spacer)
+                break;
+            ++spacer_idx;
+        }
+        m_phone_row_sizer->Insert(spacer_idx, m_search, 1, wxALIGN_CENTER_VERTICAL | wxLEFT | wxRIGHT, m_btn_margin);
+        m_phone_spacer->SetProportion(0);
+    } else {
+        m_phone_row_sizer->Detach(m_search);
+        m_phone_spacer->SetProportion(1);
+        m_sizer->Add(m_search, 0, wxEXPAND | wxLEFT | wxRIGHT | wxBOTTOM, m_btn_margin);
+    }
+    // the height changes: lay out the top bar's parent too
+    CallAfter([this]() {
+        GetParent()->Layout();
+    });
+}
