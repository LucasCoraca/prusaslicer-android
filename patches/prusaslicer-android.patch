+// Phone layout: option labels wrap to as many lines as they need (the desktop breaks a long label once).
+static wxString wrap_words(const wxString& text, int width, const std::function<int(const wxString&)>& text_width)
+{
+    wxString out, line;
+    for (const wxString& word : wxSplit(text, ' ', '\0')) {
+        const wxString candidate = line.empty() ? word : line + ' ' + word;
+        if (!line.empty() && text_width(candidate) > width) {
+            out += line + '\n';
+            line = word;
+        } else
+            line = candidate;
+    }
+    return out + line;
+}
+
+static int label_lines(wxWindow* win, const wxString& label, int width)
+{
+    if (win->GetTextExtent(label).GetWidth() <= width)
+        return 1;
