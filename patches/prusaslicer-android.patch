+// The phone layout's wizard fills a narrow screen: texts wrap to its width, printers are picked from two columns.
+static int wrap_width()
+{
+    return is_phone_layout() ? std::min<int>(WRAP_WIDTH, wxGetDisplaySize().x - 4 * DIALOG_MARGIN) : WRAP_WIDTH;
+}
+
+static size_t printer_cols()
+{
+    return is_phone_layout() ? 2 : MAX_COLS;
+}
+
+// Break a label into lines of at most `width` px at word boundaries (check boxes and radio buttons do not wrap).
+static wxString wrap_label(wxWindow* win, const wxString& label, int width)
+{
+    wxString out, line;
+    for (const wxString& word : wxSplit(label, ' ', '\0')) {
+        const wxString candidate = line.empty() ? word : line + ' ' + word;
+        if (!line.empty() && win->GetTextExtent(candidate).x > width) {
+            out += line + '\n';
+            line = word;
+        } else
+            line = candidate;
+    }
+    return out + line;
+}
+
+// Phone layout: wrap the texts of a wizard page to the screen width, so that the page does not scroll sideways.
+static void fit_page_texts(wxWindow* win, int width)
+{
+    for (wxWindow* child : win->GetChildren()) {
+        if (wxStaticText* text = dynamic_cast<wxStaticText*>(child)) {
+            if (text->GetSize().x > width || text->GetBestSize().x > width) {
+                text->Wrap(width);
+                text->SetMinSize(wxSize(std::min(text->GetMinSize().x, width), -1));
+            }
+        } else if (dynamic_cast<wxCheckBox*>(child) || dynamic_cast<wxRadioButton*>(child)) {
+            if (child->GetBestSize().x > width) {
+                child->SetLabel(wrap_label(child, child->GetLabel(), width - 3 * DIALOG_MARGIN));
+                child->InvalidateBestSize();
+                child->SetMinSize(wxDefaultSize);
+            }
+        } else if (!child->IsTopLevel())
+            fit_page_texts(child, width);
+    }
+}
+
