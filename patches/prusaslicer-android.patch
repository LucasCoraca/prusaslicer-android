@@ -0,0 +1,75 @@
+// WebViewPlatformUtils for Android: wxWebView is wxWebViewAndroid (third_party/wxWidgets/src/qt/webview_android.cpp),
+// whose native backend is the org.orcaport.wx.WebViewBridge Java object driving an android.webkit.WebView.
+#include "WebViewPlatformUtils.hpp"
+
+#include <QtCore/QJniObject>
+
+#include <boost/log/trivial.hpp>
+
+namespace Slic3r::GUI {
+
+static QJniObject bridge_of(wxWebView* web_view)
+{
+    if (web_view == nullptr || web_view->GetNativeBackend() == nullptr)
+        return {};
+    return QJniObject(static_cast<jobject>(web_view->GetNativeBackend()));
+}
+
+void setup_webview_with_credentials(wxWebView* web_view, const std::string& username, const std::string& password)
+{
+    QJniObject bridge = bridge_of(web_view);
+    if (bridge.isValid())
+        bridge.callMethod<void>("setHttpAuth", "(Ljava/lang/String;Ljava/lang/String;)V",
+            QJniObject::fromString(QString::fromStdString(username)).object<jstring>(),
+            QJniObject::fromString(QString::fromStdString(password)).object<jstring>());
+}
+
+void remove_webview_credentials(wxWebView* web_view)
+{
+    QJniObject bridge = bridge_of(web_view);
+    if (bridge.isValid())
+        bridge.callMethod<void>("setHttpAuth", "(Ljava/lang/String;Ljava/lang/String;)V", jstring(nullptr), jstring(nullptr));
+}
+
+void delete_cookies(wxWebView* web_view, const std::string& url)
+{
+    (void)web_view; // one CookieManager per app
+    QJniObject::callStaticMethod<void>("org/orcaport/wx/WebViewBridge", "deleteCookies", "(Ljava/lang/String;)V",
+        QJniObject::fromString(QString::fromStdString(url)).object<jstring>());
+}
+
+void delete_cookies_with_counter(wxWebView* web_view, const std::string& url, std::atomic<size_t>& counter)
+{
+    delete_cookies(web_view, url);
+    counter++;
+}
+
+void add_request_authorization(wxWebView* web_view, const wxString& address, const std::string& token)
+{
+    // unused outside Windows (see WebViewPlatformUtilsLinux.cpp)
+    (void)web_view; (void)address; (void)token;
+}
+
+void remove_request_authorization(wxWebView* web_view)
+{
+    (void)web_view;
+}
+
+void load_request(wxWebView* web_view, const std::string& address, const std::string& token)
+{
+    QJniObject bridge = bridge_of(web_view);
+    if (!bridge.isValid()) {
+        BOOST_LOG_TRIVIAL(error) << "load_request failed: no web view backend. address: " << address;
+        return;
+    }
+    if (token.empty()) {
+        web_view->LoadURL(wxString::FromUTF8(address));
+        return;
+    }
+    bridge.callMethod<void>("loadUrlWithHeader", "(Ljava/lang/String;Ljava/lang/String;Ljava/lang/String;)V",
+        QJniObject::fromString(QString::fromStdString(address)).object<jstring>(),
+        QJniObject::fromString(QStringLiteral("Authorization")).object<jstring>(),
+        QJniObject::fromString(QString::fromStdString("External " + token)).object<jstring>());
+}
+
+} // namespace Slic3r::GUI
