+#ifdef __ANDROID__
+void GLCanvas3D::on_gesture(wxGestureEvent& evt)
+{
+    if (!m_initialized || !_set_current())
+        return;
+
+    Camera& camera = wxGetApp().plater()->get_camera();
+    // gesture positions are logical (like mouse events before on_mouse() scales them)
+#if ENABLE_RETINA_GL
+    const double scale = m_retina_helper->get_scale_factor();
+#else
+    const double scale = 1.0;
+#endif
+    const wxPoint p = evt.GetPosition();
+    const Vec2d fingers(p.x * scale, p.y * scale);
+    // the bed plane point under a screen position
+    const float z = 0.0f;
+    auto on_bed = [this, &z](const Vec2d& screen) { return _mouse_to_3d(Point(coord_t(screen.x()), coord_t(screen.y())), &z, true); };
+
+    if (evt.GetEventType() == wxEVT_GESTURE_PAN) {
+        // two fingers move: drag the scene with them, as a right/middle button drag does
+        const wxPoint d = static_cast<wxPanGestureEvent&>(evt).GetDelta();
+        const Vec2d delta(d.x * scale, d.y * scale);
+        if (!wxGetApp().app_config->get_bool("use_free_camera"))
+            camera.recover_from_free_camera();
+        camera.set_target(camera.get_target() + on_bed(fingers - delta) - on_bed(fingers));
+    }
+    else if (evt.GetEventType() == wxEVT_GESTURE_ZOOM) {
+        // pinch: zoom toward the fingers - keep the bed point below them where it is
+        static double zoom_start = 1.0;
+        if (evt.IsGestureStart())
+            zoom_start = camera.get_zoom();
+        const Vec3d before = on_bed(fingers);
+        camera.set_zoom(zoom_start * static_cast<wxZoomGestureEvent&>(evt).GetZoomFactor());
+        camera.set_target(camera.get_target() + before - on_bed(fingers));
+    }
+    else if (evt.GetEventType() == wxEVT_GESTURE_ROTATE) {
+        // twist: orbit around the view axis
+        static double last_angle = 0.0;
+        if (evt.IsGestureStart())
+            last_angle = 0.0;
+        const double angle = static_cast<wxRotateGestureEvent&>(evt).GetRotationAngle();
+        camera.rotate_on_sphere(-(angle - last_angle), 0.0, current_printer_technology() != ptSLA);
+        last_angle = angle;
+    }
+    m_dirty = true;
+}
+#endif // __ANDROID__
