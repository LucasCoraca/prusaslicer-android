diff --git a/src/slic3r/GUI/PhoneLayout.hpp b/src/slic3r/GUI/PhoneLayout.hpp
new file mode 100644
index 0000000..5602714
--- /dev/null
+++ b/src/slic3r/GUI/PhoneLayout.hpp
@@ -0,0 +1,38 @@
+#ifndef slic3r_PhoneLayout_hpp_
+#define slic3r_PhoneLayout_hpp_
+
+#include <algorithm>
+#include <cstdlib>
+#include <cstring>
+
+#include <wx/gdicmn.h>
+
+namespace Slic3r {
+namespace GUI {
+
+// Android phones get a narrow-screen layout: the smaller screen side is below 600 dp (Android's own
+// tablet threshold, sw600dp). PS_LAYOUT=phone / PS_LAYOUT=tablet forces either layout.
+inline bool is_phone_layout()
+{
+#ifdef __ANDROID__
+    static const bool phone = []() {
+        if (const char* forced = std::getenv("PS_LAYOUT"))
+            return std::strcmp(forced, "phone") == 0;
+        const wxSize screen = wxGetDisplaySize();
+        return std::min(screen.x, screen.y) < 600;
+    }();
+    return phone;
+#else
+    return false;
+#endif
+}
+
+// Option labels and description texts of the settings pages, in em units: narrower on a phone
+// (labels wrap to a second line).
+inline int phone_label_width(int width) { return is_phone_layout() ? std::min(width, 13) : width; }
+inline int phone_text_wrap_width(int width) { return is_phone_layout() ? std::min(width, 28) : width; }
+
+} // namespace GUI
+} // namespace Slic3r
+
+#endif // slic3r_PhoneLayout_hpp_
